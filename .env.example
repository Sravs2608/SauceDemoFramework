# Role: template for the local .env file. Copy this file to ".env" and fill in the values.
# ".env" is git-ignored so credentials never reach GitHub; this template is committed so
# everyone knows which settings the framework needs. In GitHub Actions the same names are
# supplied by the workflow (SAUCE_PASSWORD comes from a repository secret).

# Application under test
BASE_URL=https://www.saucedemo.com

# Test users (usernames are listed on the SauceDemo login page)
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user

# Password shared by all SauceDemo users. Fill this in in your own .env file.
SAUCE_PASSWORD=
